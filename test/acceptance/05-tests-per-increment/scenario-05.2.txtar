# scenario 05.2: An increment's own pull request still waits for its tests
# On main, increment 07 has two automated scenarios without tests. A pull
# request that adds a review result of 07, one that adds only the test of
# 07.1, and one that adds review results of 06 and 07 are rejected with one
# missing test for each scenario of 07 without a test file. A pull request
# that deletes the test of 06.1 is rejected with that missing test, and
# still names 07 as waiting.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base

# A review result of 07.
exec git checkout -q -b review-07 main
mkdir evidence/07-later
cp ../review evidence/07-later/review.md
exec git add -A
exec git commit -q -m review
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*(07\.1\D.*: missing-test|: missing-test .*07\.1(\D|$))'
stdout '^check-tests: error .*(07\.2\D.*: missing-test|: missing-test .*07\.2(\D|$))'
stdout -count=2 ': missing-test'
stdout '^check-tests: 2 errors$'
! stdout 'waiting'

# The test of 07.1 only.
exec git checkout -q -b test-07-1 main
mkdir test/acceptance/07-later
cp ../test-07-1 test/acceptance/07-later/scenario-07.1.txtar
exec git add -A
exec git commit -q -m test
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*(07\.2\D.*: missing-test|: missing-test .*07\.2(\D|$))'
stdout -count=1 ': missing-test'
stdout '^check-tests: 1 errors$'
! stdout 'waiting'

# Review results of 06 and 07.
exec git checkout -q -b review-06-07 main
mkdir evidence/06-sample evidence/07-later
cp ../review evidence/06-sample/review.md
cp ../review evidence/07-later/review.md
exec git add -A
exec git commit -q -m reviews
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*(07\.1\D.*: missing-test|: missing-test .*07\.1(\D|$))'
stdout '^check-tests: error .*(07\.2\D.*: missing-test|: missing-test .*07\.2(\D|$))'
stdout -count=2 ': missing-test'
stdout '^check-tests: 2 errors$'
! stdout 'waiting'

# The test of 06.1 is deleted.
exec git checkout -q -b delete-06-1 main
exec git rm -q test/acceptance/06-sample/scenario-06.1.txtar
exec git commit -q -m delete
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*(06\.1\D.*: missing-test|: missing-test .*06\.1(\D|$))'
stdout -count=1 ': missing-test'
stdout '^check-tests: waiting 07-later 2 scenarios without tests$'
stdout '^check-tests: 1 errors$'

-- review --
No findings.
-- test-07-1 --
# scenario 07.1: A later thing works
exec later run thing
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/docs/increments/06-sample/design.md --
# Increment 06: sample

## Goal

- The sample tool works.

## Out of scope

- Everything else.

## Existing tools

- None found; searched for sample tools.

## Interface

- `sample run`

## Rollout

- Off switch: none. Failure signal: the tool rejects a correct input.

## Evidence

- Approved scenarios: 06.1.

## Scenarios

- **scenario 06.1** (automated) **A sample thing works.** Given a sample thing, the tool accepts it.
-- repo/test/acceptance/06-sample/scenario-06.1.txtar --
# scenario 06.1: A sample thing works
exec sample run thing
-- repo/docs/increments/07-later/design.md --
# Increment 07: later

## Goal

- The later tool works.

## Out of scope

- Everything else.

## Existing tools

- None found; searched for later tools.

## Interface

- `later run`

## Rollout

- Off switch: none. Failure signal: the tool rejects a correct input.

## Evidence

- Approved scenarios: 07.1 and 07.2.

## Scenarios

- **scenario 07.1** (automated) **A later thing works.** Given a later thing, the tool accepts it.
- **scenario 07.2** (automated) **A second later thing works.** Given a second later thing, the tool accepts it.
