# scenario 05.6: The other model gets only the notes of the pull request's own increments
# standin.py is the stand-in for the other model. It listens on a free port
# of 127.0.0.1, writes repo/.factory/cross-review.json with its endpoint and
# the models design-model and code-model, and then creates the file ready.
# For each request with the right key, it writes the model to the file
# model and the content of all messages to the file request, and answers
# with no findings.
env PYTHONDONTWRITEBYTECODE=1
env FACTORY_MODEL_KEY=test-key
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
! exec python3 standin.py &standin&
exec sh -c 'n=0; while [ ! -f ready ]; do n=$((n+1)); [ $n -gt 100 ] && exit 1; sleep 0.1; done'

cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base

# A code file and a review result of 06: the diff and the note of 06, and
# nothing of 07.
exec git checkout -q -b code main
cp ../edit internal/x.go
mkdir evidence/06-sample
cp ../review evidence/06-sample/review.md
exec git add -A
exec git commit -q -m code
exec factory cross-review --base main
stdout '^cross-review: ok$'
grep '^code-model$' ../model
grep 'marker-in-the-diff' ../request
grep 'Increment 06: sample' ../request
grep 'The sample tool works' ../request
! grep 'Increment 07|The later tool works|later thing works' ../request

# Review results of 06 and 07: both notes.
exec git checkout -q -b reviews main
mkdir evidence/06-sample evidence/07-later
cp ../review evidence/06-sample/review.md
cp ../review evidence/07-later/review.md
exec git add -A
exec git commit -q -m reviews
rm ../request
exec factory cross-review --base main
stdout '^cross-review: ok$'
grep 'Increment 06: sample' ../request
grep 'The sample tool works' ../request
grep 'Increment 07: later' ../request
grep 'The later tool works' ../request

# Only README.md: the diff, and neither note nor a scenario title.
exec git checkout -q -b readme main
cp ../readme README.md
exec git commit -q -a -m readme
rm ../request
exec factory cross-review --base main
stdout '^cross-review: ok$'
grep 'marker-in-the-readme' ../request
! grep 'Increment 0[67]|The sample tool works|The later tool works|sample thing works|later thing works' ../request

kill standin
wait standin

-- edit --
package x // marker-in-the-diff
-- readme --
# Sample, marker-in-the-readme
-- review --
No findings.
-- standin.py --
import http.server
import json
import os

KEY = "Bearer test-key"


def read_body(handler):
    if handler.headers.get("Transfer-Encoding", "").lower() == "chunked":
        body = b""
        while True:
            size = int(handler.rfile.readline().strip().split(b";")[0], 16)
            if size == 0:
                handler.rfile.readline()
                return body
            body += handler.rfile.read(size)
            handler.rfile.readline()
    return handler.rfile.read(int(handler.headers.get("Content-Length", "0")))


class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = read_body(self)
        if self.path != "/v1/chat/completions":
            return self.reply(404, {"error": "unknown path " + self.path})
        if self.headers.get("Authorization") != KEY:
            return self.reply(401, {"error": "wrong key"})
        try:
            request = json.loads(body)
            model = request["model"]
            contents = [m["content"] for m in request["messages"]]
        except (ValueError, KeyError, TypeError):
            return self.reply(400, {"error": "bad request"})
        with open("model", "w") as f:
            f.write(model + "\n")
        with open("request", "w") as f:
            f.write("\n".join(c if isinstance(c, str) else json.dumps(c) for c in contents) + "\n")
        self.reply(200, {
            "id": "chatcmpl-1",
            "object": "chat.completion",
            "model": model,
            "choices": [{
                "index": 0,
                "message": {"role": "assistant", "content": "{\"findings\": []}"},
                "finish_reason": "stop",
            }],
        })

    def reply(self, status, data):
        out = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    def log_message(self, *args):
        pass


server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
os.makedirs("repo/.factory", exist_ok=True)
with open("repo/.factory/cross-review.json", "w") as f:
    json.dump({
        "endpoint": "http://127.0.0.1:%d/v1" % server.server_address[1],
        "models": {"design": "design-model", "code": "code-model"},
    }, f)
open("ready", "w").close()
server.serve_forever()
