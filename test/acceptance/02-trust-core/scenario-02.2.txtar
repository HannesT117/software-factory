# scenario 02.2: Invalid skills fail with a code
# Each skill breaks one rule. The error line names the code for its file.
exitcode 1 factory validate-skills skills
stdout '^validate-skills: error \S*wrong-folder/SKILL\.md(:\d+)?: name-mismatch( |$)'
stdout '^validate-skills: error \S*bad--name/SKILL\.md(:\d+)?: name-format( |$)'
stdout '^validate-skills: error \S*this-skill-name-has-more-than-sixty-four-characters-so-it-fails-x/SKILL\.md(:\d+)?: name-too-long( |$)'
stdout '^validate-skills: error \S*no-description/SKILL\.md(:\d+)?: description-missing( |$)'
stdout '^validate-skills: error \S*long-description/SKILL\.md(:\d+)?: description-too-long( |$)'
stdout '^validate-skills: error \S*long-compatibility/SKILL\.md(:\d+)?: compatibility-too-long( |$)'
stdout '^validate-skills: error \S*metadata-string/SKILL\.md(:\d+)?: metadata-not-map( |$)'
stdout '^validate-skills: error \S*extra-field/SKILL\.md(:\d+)?: unknown-field( |$)'
stdout '^validate-skills: error \S*no-frontmatter/SKILL\.md(:\d+)?: no-frontmatter( |$)'
stdout '^validate-skills: error \S*yaml-list/SKILL\.md(:\d+)?: unsupported-yaml( |$)'
stdout '^validate-skills: error \S*names-a-tool/SKILL\.md(:\d+)?: tool-name( |$)'
stdout '^validate-skills: \d+ errors$'

