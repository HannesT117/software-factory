# scenario 02.13: Only the test writer may write tests
# Each input file is the hook input for one tool call in the project
# $WORK/project. The hook denies a call with a deny or block decision.
exec sh -c 'for f in *.json; do sed "s|@WORK@|$(pwd)|g" "$f" > "$f.new" && mv "$f.new" "$f"; done'
exec git init -q project
cd project

# Write, Edit, MultiEdit and NotebookEdit on the tests group and on the
# CI-and-config group are denied.
stdin ../write-test.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../edit-go-mod.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../multiedit-go-sum.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../notebookedit-github.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../write-factory.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../edit-workflow.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'

# A session started as acceptance-test-writer may write to test/acceptance/.
stdin ../writer-write-test.json
exec factory hook pre-tool-use
! stdout '"deny"|"block"'
stdin ../writer-edit-test.json
exec factory hook pre-tool-use
! stdout '"deny"|"block"'

# Not so a subagent of that session, another agent type, or the test writer
# on go.mod or on a file under .github/.
stdin ../writer-subagent-test.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../reviewer-test.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../writer-go-mod.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'
stdin ../writer-workflow.json
exec factory hook pre-tool-use
stdout '"permissionDecision"\s*:\s*"deny"|"decision"\s*:\s*"block"'

# A path outside the groups is not protected.
stdin ../write-code.json
exec factory hook pre-tool-use
! stdout '"deny"|"block"'

-- write-test.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/test/acceptance/05-sample/scenario-05.1.txtar","content":"changed\n"}}
-- edit-go-mod.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"@WORK@/project/go.mod","old_string":"a","new_string":"b"}}
-- multiedit-go-sum.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"MultiEdit","tool_input":{"file_path":"@WORK@/project/go.sum","edits":[{"old_string":"a","new_string":"b"}]}}
-- notebookedit-github.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"NotebookEdit","tool_input":{"notebook_path":"@WORK@/project/.github/notebook.ipynb","new_source":"print(1)"}}
-- write-factory.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/.factory/allowed-hosts","content":"example.com\n"}}
-- edit-workflow.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"@WORK@/project/.github/workflows/checks.yml","old_string":"a","new_string":"b"}}
-- writer-write-test.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/test/acceptance/05-sample/scenario-05.1.txtar","content":"changed\n"},"agent_type":"acceptance-test-writer"}
-- writer-edit-test.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"@WORK@/project/test/acceptance/acceptance_test.go","old_string":"a","new_string":"b"},"agent_type":"acceptance-test-writer"}
-- writer-subagent-test.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/test/acceptance/05-sample/scenario-05.1.txtar","content":"changed\n"},"agent_id":"a1","agent_type":"acceptance-test-writer"}
-- reviewer-test.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/test/acceptance/05-sample/scenario-05.1.txtar","content":"changed\n"},"agent_type":"increment-reviewer"}
-- writer-go-mod.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/go.mod","content":"changed\n"},"agent_type":"acceptance-test-writer"}
-- writer-workflow.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/.github/workflows/checks.yml","content":"changed\n"},"agent_type":"acceptance-test-writer"}
-- write-code.json --
{"session_id":"s1","transcript_path":"@WORK@/s1.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/internal/x.go","content":"changed\n"}}
