# scenario 02.19: Each mistake in a decision record is reported
# Each record breaks one rule. The error line names the code with the line
# number. A missing title, a missing section and a wrong folder have no line
# of their own, so their line number is optional. The status of
# architecture/0005 names ADR-0007, which exists only in the category
# process.
exitcode 1 factory check-adr docs/decisions
stdout '^check-adr: error \S*architecture/0001-unknown-field\.md:2: unknown-field( |$)'
stdout '^check-adr: error \S*architecture/0002-bad-date\.md:2: bad-date( |$)'
stdout '^check-adr: error \S*architecture/0003-bad-status\.md:2: bad-status( |$)'
stdout '^check-adr: error \S*architecture/0004-unknown-adr\.md:2: unknown-adr( |$)'
stdout '^check-adr: error \S*architecture/0005-other-category-adr\.md:2: unknown-adr( |$)'
stdout '^check-adr: error \S*process/0001-missing-title\.md(:\d+)?: missing-title( |$)'
stdout '^check-adr: error \S*process/0002-missing-section\.md(:\d+)?: missing-section( |$)'
stdout '^check-adr: error \S*process/0003-unknown-section\.md:7: unknown-section( |$)'
stdout '^check-adr: error \S*process/0004-unknown-subsection\.md:16: unknown-section( |$)'
! stdout 'process/0007-correct\.md'
stdout '^check-adr: error \S*design/0001-unknown-category\.md(:\d+)?: unknown-category( |$)'
stdout '^check-adr: \d+ errors$'

