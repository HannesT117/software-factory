# scenario 02.31: Deviations from the best practices are warnings
# Each folder under w/ holds one skill with exactly one deviation. Without
# --strict, the skill gets a warning that names the file and the code, and
# it is accepted. With --strict, it is rejected.

# Long files are written here, so that this file stays short.
exec sh -c 'i=0; while [ $i -lt 501 ]; do i=$((i+1)); echo "Step $i runs the check."; done >> w/body-too-long/checking-length/SKILL.md'
exec sh -c 'i=0; while [ $i -lt 120 ]; do i=$((i+1)); echo "Step $i runs the check."; done >> w/missing-contents/checking-contents/reference.md'

exec factory validate-skills w/name-not-gerund
stdout '^validate-skills: warning \S*w/name-not-gerund/pdf-helper/SKILL\.md(:\d+)?: name-not-gerund( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/name-not-gerund
stdout ': name-not-gerund( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/description-voice
stdout '^validate-skills: warning \S*w/description-voice/checking-voice/SKILL\.md(:\d+)?: description-voice( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/description-voice
stdout ': description-voice( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/body-too-long
stdout '^validate-skills: warning \S*w/body-too-long/checking-length/SKILL\.md(:\d+)?: body-too-long( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/body-too-long
stdout ': body-too-long( |$)'
stdout '^validate-skills: \d+ errors$'

# SKILL.md links guide.md, and guide.md links details.md. The warning may
# name either file of the skill.
exec factory validate-skills w/unlinked-reference
stdout '^validate-skills: warning \S*w/unlinked-reference/checking-links/\S+\.md(:\d+)?: unlinked-reference( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/unlinked-reference
stdout ': unlinked-reference( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/missing-contents
stdout '^validate-skills: warning \S*w/missing-contents/checking-contents/reference\.md(:\d+)?: missing-contents( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/missing-contents
stdout ': missing-contents( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/reader-voice
stdout '^validate-skills: warning \S*w/reader-voice/checking-readers/SKILL\.md(:\d+)?: reader-voice( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/reader-voice
stdout ': reader-voice( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/path-style
stdout '^validate-skills: warning \S*w/path-style/checking-paths/SKILL\.md(:\d+)?: path-style( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/path-style
stdout ': path-style( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/time-phrase
stdout '^validate-skills: warning \S*w/time-phrase/checking-dates/SKILL\.md(:\d+)?: time-phrase( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/time-phrase
stdout ': time-phrase( |$)'
stdout '^validate-skills: \d+ errors$'

exec factory validate-skills w/agent-term
stdout '^validate-skills: warning \S*w/agent-term/checking-terms/SKILL\.md(:\d+)?: agent-term( |$)'
stdout '^validate-skills: ok \d+ checked$'
exitcode 1 factory validate-skills --strict w/agent-term
stdout ': agent-term( |$)'
stdout '^validate-skills: \d+ errors$'

