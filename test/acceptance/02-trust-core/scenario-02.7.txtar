# scenario 02.7: Code waits for its tests
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com

# The note is on the base branch, and its test file is missing.
cd $WORK/missing
exec git init -q -b main
exec git add -A
exec git commit -q -m note
exec git checkout -q -b work
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*: missing-test( |$)'

# The note and its test file are on the base branch, and the branch deletes
# the test file.
cd $WORK/deleted
exec git init -q -b main
exec git add -A
exec git commit -q -m 'note and test'
exec git checkout -q -b work
rm test/acceptance/05-sample/scenario-05.1.txtar
exec git commit -q -a -m 'delete test'
exitcode 1 factory check-tests --base main
stdout '^check-tests: error .*: missing-test( |$)'

# The note exists only on the branch of the pull request and has no test
# file yet.
cd $WORK/new
exec git init -q -b main
exec git add README.md
exec git commit -q -m base
exec git checkout -q -b work
exec git add docs
exec git commit -q -m note
exec factory check-tests --base main
stdout '^check-tests: ok \d+ checked$'

-- missing/docs/increments/05-sample/design.md --
