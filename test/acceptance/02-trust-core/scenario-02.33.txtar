{"session_id":"s2","transcript_path":"@WORK@/transcripts/skill.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"@WORK@/project/core/skills/checking-things/SKILL.md","old_string":"one","new_string":"two"}}
-- skill-write-reference.json --
{"session_id":"s2","transcript_path":"@WORK@/transcripts/skill.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/core/skills/checking-things/references/guide.md","content":"# Guide\n"}}
-- skill-write-new-skill.json --
{"session_id":"s2","transcript_path":"@WORK@/transcripts/skill.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/core/skills/new-skill/SKILL.md","content":"---\nname: new-skill\n---\n"}}
