{"session_id":"s1","transcript_path":"@WORK@/transcripts/none.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Write","tool_input":{"file_path":"@WORK@/project/core/skills/new-skill/SKILL.md","content":"---\nname: new-skill\n---\n"}}
