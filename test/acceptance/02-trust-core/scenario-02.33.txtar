{"session_id":"s3","transcript_path":"@WORK@/transcripts/read.jsonl","cwd":"@WORK@/project","hook_event_name":"PreToolUse","tool_name":"Edit","tool_input":{"file_path":"@WORK@/project/core/skills/checking-things/SKILL.md","old_string":"one","new_string":"two"}}
