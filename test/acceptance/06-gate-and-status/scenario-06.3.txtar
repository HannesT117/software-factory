# scenario 06.3: Status names the code commit that waits for a review
# The repo holds the notes of 07, 08 and 09, and internal/ is code. A
# commit on the branch work changes internal/x.go, and no review result
# names it: status names that commit. After a commit that adds a review
# result naming it, status names no commit.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base
exec git checkout -q -b work
cp ../edit internal/x.go
exec git commit -q -a -m code
exec git tag code

exec factory status
cp stdout ../out
exec sh -c 'grep -qx "status: review-open $(git rev-parse code)" ../out'

exec sh ../review.sh evidence/07-sample/review.md code 'Result: 0 blocking, 0 notes' 0 0
exec git add evidence
exec git commit -q -m review
exec factory status
! stdout 'review-open'

-- edit --
package x // changed
-- review.sh --
# review.sh <file> <commit> <Result line> <blocking findings> <notes> [<extra line>]
# writes a review result that names the full hash of <commit>.
f=$1
h=$(git rev-parse "$2")
mkdir -p "$(dirname "$f")"
{
  echo "# Review"
  echo
  echo "Reviewed commit: $h"
  echo "$3"
  if [ -n "$6" ]; then echo; echo "$6"; fi
  echo
  echo "## Findings"
  echo
  i=0; while [ "$i" -lt "$4" ]; do i=$((i+1)); echo "- **blocking** internal/x.go: The loop $i never ends."; done
  i=0; while [ "$i" -lt "$5" ]; do i=$((i+1)); echo "- **note** internal/x.go: The name $i says little."; done
} > "$f"
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/.factory/code-paths --
internal/**
-- repo/docs/increments/07-sample/design.md --
# Increment 07: sample

## Goal

- The sample tool of increment 07 works.

## Out of scope

- Everything else.

## Existing tools

- None found; searched for sample tools.

## Interface

- `sample run`

## Rollout

- Off switch: none. Failure signal: the tool rejects a correct input.

## Evidence

- Approved scenarios: 07.1.

## Scenarios

- **scenario 07.1** (automated) **A sample thing works.** Given a sample thing, the tool accepts it.
- **scenario 07.2** (manual) **A person checks the sample.** Given a sample thing, the tool accepts it.
