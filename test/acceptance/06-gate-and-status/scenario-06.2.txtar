# scenario 06.2: A failed or malformed result keeps an increment open
# The repo is the one of scenario 06.1. A later line of the results file of
# 07 records its manual scenario as failed: 07 waits for results and names
# the scenario as failed. A results file with a line in another form, and
# one with a result for the automated scenario 07.1, are rejected with the
# file and line.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base

cp ../failed evidence/07-sample/results.md
exec factory status
stdout '^status: 07-sample results$'
stdout '^status: 07-sample failed 07\.2$'
! stdout '^status: 07-sample done$'
stdout '^status: ok 3 checked$'

cp ../malformed evidence/07-sample/results.md
exitcode 1 factory status
stdout '^status: error \S*evidence/07-sample/results\.md:4: bad-result-line( |$)'
stdout '^status: 1 errors$'

cp ../automated evidence/07-sample/results.md
exitcode 1 factory status
stdout '^status: error \S*evidence/07-sample/results\.md:4: unknown-scenario 07\.1( |$)'
stdout '^status: 1 errors$'

-- failed --
# Results of increment 07

- 07.2 passed 2026-11-01: ran the sample tool by hand.
- 07.2 failed 2026-11-02: ran it again; it rejects a sample thing.
-- malformed --
# Results of increment 07

- 07.2 passed 2026-11-01: ran the sample tool by hand.
- 07.2 done yesterday
-- automated --
# Results of increment 07

- 07.2 passed 2026-11-01: ran the sample tool by hand.
- 07.1 passed 2026-11-01: ran the test by hand.
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/.factory/code-paths --
internal/**
-- repo/docs/increments/07-sample/design.md --
# Increment 07: sample

## Goal

- The sample tool of increment 07 works.

## Out of scope

- Everything else.

