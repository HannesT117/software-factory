# scenario 06.6: The Result line must match the findings
# On the branch mismatch, the review result of the code commit counts no
# blocking finding in its Result line, but its findings hold one. On the
# branch no-findings, its Result line is "Result: no findings". Both are
# rejected.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base
exec git checkout -q -b work main
cp ../edit internal/x.go
exec git commit -q -a -m code
exec git tag code

exec git checkout -q -b mismatch code
exec sh ../review.sh evidence/07-sample/review.md code 'Result: 0 blocking, 0 notes' 1 0
exec git add evidence
exec git commit -q -m review
exitcode 1 factory check-review --base main
stdout '^check-review: error \S*evidence/07-sample/review\.md: result-mismatch( |$)'
! stdout '^check-review: ok '

exec git checkout -q -b no-findings code
exec sh ../review.sh evidence/07-sample/review.md code 'Result: no findings' 0 0
exec git add evidence
exec git commit -q -m review
exitcode 1 factory check-review --base main
stdout '^check-review: error \S*evidence/07-sample/review\.md: bad-result( |$)'
! stdout '^check-review: ok '

-- edit --
package x // changed
-- review.sh --
# review.sh <file> <commit> <Result line> <blocking findings> <notes> [<extra line>]
# writes a review result that names the full hash of <commit>.
f=$1
h=$(git rev-parse "$2")
mkdir -p "$(dirname "$f")"
{
  echo "# Review"
  echo
  echo "Reviewed commit: $h"
  echo "$3"
  if [ -n "$6" ]; then echo; echo "$6"; fi
  echo
  echo "## Findings"
  echo
  i=0; while [ "$i" -lt "$4" ]; do i=$((i+1)); echo "- **blocking** internal/x.go: The loop $i never ends."; done
  i=0; while [ "$i" -lt "$5" ]; do i=$((i+1)); echo "- **note** internal/x.go: The name $i says little."; done
} > "$f"
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/.factory/code-paths --
internal/**
