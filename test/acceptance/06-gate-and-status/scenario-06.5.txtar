# scenario 06.5: A missing review result holds the merge
# The branch work changes internal/x.go and has no review result: it is
# rejected, and the output names that commit. The branch later adds a
# review result for that commit and then a second code commit: it is
# rejected for the second commit. The branch readme changes only README.md:
# it passes with no code change.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base
exec git checkout -q -b work main
cp ../edit internal/x.go
exec git commit -q -a -m code
exec git tag code

exitcode 1 factory check-review --base main
cp stdout ../out
exec sh -c 'grep -qE "^check-review: error $(git rev-parse code): missing-review( |$)" ../out'
stdout '^check-review: 1 errors$'

exec git checkout -q -b later code
exec sh ../review.sh evidence/07-sample/review.md code 'Result: 0 blocking, 0 notes' 0 0
exec git add evidence
exec git commit -q -m review
cp ../edit-again internal/x.go
exec git commit -q -a -m 'more code'
exec git tag code2
exitcode 1 factory check-review --base main
cp stdout ../out
exec sh -c 'grep -qE "^check-review: error $(git rev-parse code2): missing-review( |$)" ../out'
! stdout '^check-review: reviewed '
stdout '^check-review: 1 errors$'

exec git checkout -q -b readme main
cp ../readme README.md
exec git commit -q -a -m readme
exec factory check-review --base main
stdout '^check-review: no code change$'
stdout '^check-review: ok 0 checked$'
! stdout ': error '

-- edit-again --
package x // changed again
-- readme --
# Sample, changed
-- edit --
package x // changed
-- review.sh --
# review.sh <file> <commit> <Result line> <blocking findings> <notes> [<extra line>]
# writes a review result that names the full hash of <commit>.
f=$1
h=$(git rev-parse "$2")
mkdir -p "$(dirname "$f")"
{
  echo "# Review"
  echo
  echo "Reviewed commit: $h"
  echo "$3"
  if [ -n "$6" ]; then echo; echo "$6"; fi
  echo
  echo "## Findings"
  echo
  i=0; while [ "$i" -lt "$4" ]; do i=$((i+1)); echo "- **blocking** internal/x.go: The loop $i never ends."; done
  i=0; while [ "$i" -lt "$5" ]; do i=$((i+1)); echo "- **note** internal/x.go: The name $i says little."; done
} > "$f"
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/.factory/code-paths --
internal/**
