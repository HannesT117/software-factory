# scenario 06.7: After two rounds, the engineer decides
# On the branch work, one commit adds a review result of the code commit
# with a blocking finding: the output names round 1 and not the engineer.
# A second commit changes that review result, which still holds a blocking
# finding: the output names round 2 and says that the engineer decides.
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base
exec git checkout -q -b work main
cp ../edit internal/x.go
exec git commit -q -a -m code
exec git tag code

exec sh ../review.sh evidence/07-sample/review.md code 'Result: 1 blocking, 0 notes' 1 0
exec git add evidence
exec git commit -q -m 'review round 1'
exitcode 1 factory check-review --base main
stdout '^check-review: error \S*evidence/07-sample/review\.md: blocking 1( |$)'
! stdout 'engineer'
cp stdout ../out
exec sh -c 'grep -qE "^check-review: reviewed $(git rev-parse code) in [^ ]*evidence/07-sample/review\.md, round 1$" ../out'

exec sh ../review.sh evidence/07-sample/review.md code 'Result: 1 blocking, 0 notes' 1 0 'The second round found the loop again.'
exec git commit -q -a -m 'review round 2'
exitcode 1 factory check-review --base main
stdout '^check-review: error \S*evidence/07-sample/review\.md: blocking 1 .*after 2 rounds the engineer decides$'
stdout '^check-review: 1 errors$'
cp stdout ../out
exec sh -c 'grep -qE "^check-review: reviewed $(git rev-parse code) in [^ ]*evidence/07-sample/review\.md, round 2$" ../out'

-- edit --
package x // changed
-- review.sh --
# review.sh <file> <commit> <Result line> <blocking findings> <notes> [<extra line>]
# writes a review result that names the full hash of <commit>.
f=$1
h=$(git rev-parse "$2")
mkdir -p "$(dirname "$f")"
{
  echo "# Review"
  echo
  echo "Reviewed commit: $h"
  echo "$3"
  if [ -n "$6" ]; then echo; echo "$6"; fi
  echo
  echo "## Findings"
  echo
  i=0; while [ "$i" -lt "$4" ]; do i=$((i+1)); echo "- **blocking** internal/x.go: The loop $i never ends."; done
  i=0; while [ "$i" -lt "$5" ]; do i=$((i+1)); echo "- **note** internal/x.go: The name $i says little."; done
} > "$f"
-- repo/README.md --
# Sample
-- repo/internal/x.go --
package x
-- repo/.factory/code-paths --
internal/**
