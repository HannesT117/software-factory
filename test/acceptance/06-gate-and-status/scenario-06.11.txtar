# scenario 06.11: The other model reviews the tests before the code
# standin.py is the stand-in for the other model. It listens on a free port
# of 127.0.0.1, writes repo/.factory/cross-review.json with its endpoint and
# the models design-model and code-model, and then creates the file ready.
# For each request with the right key, it writes the model to the file
# model and the content of all messages to the file request, and answers
# with the content of the file answer, or with no findings without it.
# The branch tests adds only a test file of increment 08, and no review
# result names that commit. It is sent all the same, to the model for code,
# with the note of 08, its scenario titles and the diff.
env PYTHONDONTWRITEBYTECODE=1
env FACTORY_MODEL_KEY=test-key
env GIT_AUTHOR_NAME=Agent GIT_AUTHOR_EMAIL=agent@example.com GIT_COMMITTER_NAME=Agent GIT_COMMITTER_EMAIL=agent@example.com
! exec python3 standin.py &standin&
exec sh -c 'n=0; while [ ! -f ready ]; do n=$((n+1)); [ $n -gt 100 ] && exit 1; sleep 0.1; done'

cd repo
exec git init -q -b main
exec git add -A
exec git commit -q -m base
exec git checkout -q -b tests main
mkdir test/acceptance/08-later
cp ../test-08-1 test/acceptance/08-later/scenario-08.1.txtar
exec git add test
exec git commit -q -m test
exec sh -c 'rm -f ../request ../model'

exec factory cross-review --base main
stdout '\Across-review: model code-model\n'
stdout '^cross-review: ok$'
! stdout 'waiting for a review result'
grep '^code-model$' ../model
grep 'Increment 08: later' ../request
grep 'A later thing works' ../request
grep 'A second later thing works' ../request
grep 'marker-in-the-test' ../request

kill standin
wait standin

-- test-08-1 --
# scenario 08.1: A later thing works
exec later run marker-in-the-test
-- review.sh --
# review.sh <file> <commit> <Result line> <blocking findings> <notes> [<extra line>]
# writes a review result that names the full hash of <commit>.
f=$1
h=$(git rev-parse "$2")
mkdir -p "$(dirname "$f")"
{
  echo "# Review"
  echo
  echo "Reviewed commit: $h"
  echo "$3"
  if [ -n "$6" ]; then echo; echo "$6"; fi
  echo
  echo "## Findings"
  echo
  i=0; while [ "$i" -lt "$4" ]; do i=$((i+1)); echo "- **blocking** internal/x.go: The loop $i never ends."; done
  i=0; while [ "$i" -lt "$5" ]; do i=$((i+1)); echo "- **note** internal/x.go: The name $i says little."; done
} > "$f"
-- standin.py --
import http.server
import json
import os

KEY = "Bearer test-key"


def read_body(handler):
    if handler.headers.get("Transfer-Encoding", "").lower() == "chunked":
        body = b""
        while True:
            size = int(handler.rfile.readline().strip().split(b";")[0], 16)
            if size == 0:
                handler.rfile.readline()
                return body
            body += handler.rfile.read(size)
            handler.rfile.readline()
    return handler.rfile.read(int(handler.headers.get("Content-Length", "0")))


class Handler(http.server.BaseHTTPRequestHandler):
    def do_POST(self):
        body = read_body(self)
        if self.path != "/v1/chat/completions":
            return self.reply(404, {"error": "unknown path " + self.path})
        if self.headers.get("Authorization") != KEY:
            return self.reply(401, {"error": "wrong key"})
        try:
            request = json.loads(body)
            model = request["model"]
            contents = [m["content"] for m in request["messages"]]
        except (ValueError, KeyError, TypeError):
            return self.reply(400, {"error": "bad request"})
        with open("model", "w") as f:
            f.write(model + "\n")
        with open("request", "w") as f:
            f.write("\n".join(c if isinstance(c, str) else json.dumps(c) for c in contents) + "\n")
        content = '{"findings": []}'
        if os.path.exists("answer"):
            with open("answer") as f:
                content = f.read()
        self.reply(200, {
            "id": "chatcmpl-1",
            "object": "chat.completion",
            "model": model,
            "choices": [{
                "index": 0,
                "message": {"role": "assistant", "content": content},
                "finish_reason": "stop",
            }],
        })

    def reply(self, status, data):
        out = json.dumps(data).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(out)))
        self.end_headers()
        self.wfile.write(out)

    def log_message(self, *args):
        pass


server = http.server.HTTPServer(("127.0.0.1", 0), Handler)
os.makedirs("repo/.factory", exist_ok=True)
with open("repo/.factory/cross-review.json", "w") as f:
    json.dump({
        "endpoint": "http://127.0.0.1:%d/v1" % server.server_address[1],
        "models": {"design": "design-model", "code": "code-model"},
    }, f)
open("ready", "w").close()
server.serve_forever()
